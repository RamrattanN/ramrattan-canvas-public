{
  "name": "ramrattan-canvas",
  "version": "5.0.0",
  "private": true,
  "description": "Local-only GitHub Kanban canvas. Read-only GitHub access through the GitHub CLI.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test board-core.test.mjs github-reader.test.mjs demo/fixture.test.mjs scripts/distribution.test.mjs",
    "demo:fixture": "node demo/generate-fixture.mjs",
    "demo:capture": "node --experimental-websocket demo/capture.mjs",
    "dist:prepare": "node scripts/prepare-distribution.mjs"
  }
}
